# LLM API Keys (choose one or both)
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-anthropic-key-here

# LLM Configuration
LLM_PROVIDER=openai  # Options: openai, anthropic
LLM_MODEL=gpt-4-turbo-preview  # or claude-3-opus-20240229
LLM_TEMPERATURE=0.0
EMBEDDING_MODEL=text-embedding-3-small

# Database Configuration (Read-only credentials)
# For CSV mode (no database required): Set DATABASE_TYPE=csv
# For traditional database: Use postgresql, mysql, or snowflake
DATABASE_URL=postgresql://readonly_user:password@localhost:5432/analytics_db
DATABASE_TYPE=csv  # Options: csv, postgresql, mysql, snowflake
DATABASE_QUERY_TIMEOUT=30
DATABASE_POOL_SIZE=5

# CSV Mode Configuration (only used when DATABASE_TYPE=csv)
CSV_DATA_DIR=./data/csv  # Directory containing CSV files

# Safety Configuration
MAX_RESULT_ROWS=10000
MAX_QUERY_TIMEOUT_SECONDS=30
ALLOWED_TABLES=orders,customers,products,order_line_items,sales_reps
BLOCKED_COLUMNS=ssn,social_security_number,credit_card,password,api_key,secret

# Vector Store Configuration
CHROMA_PERSIST_DIR=./data/vector_store
CHROMA_COLLECTION_NAME=data_dictionary

# Audit Logging
AUDIT_LOG_PATH=./data/audit_logs
AUDIT_LOG_ENABLED=true

# Application Configuration
APP_ENV=development  # Options: development, staging, production
LOG_LEVEL=INFO  # Options: DEBUG, INFO, WARNING, ERROR
API_PORT=8000
API_HOST=0.0.0.0

# Security (Optional - integrate with your auth system)
# JWT_SECRET=your-secret-key
# JWT_ALGORITHM=HS256
# JWT_EXPIRATION_HOURS=24

# Rate Limiting (Optional)
# RATE_LIMIT_PER_MINUTE=10
# RATE_LIMIT_PER_HOUR=100

# Feature Flags
ENABLE_AGENTIC_TOOLS=false
ENABLE_RESULT_CACHING=false
ENABLE_QUERY_OPTIMIZATION=false
